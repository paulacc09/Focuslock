# ==============================================================================
# FOCUSLOCK — VARIABLES DE ENTORNO
# ==============================================================================

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Configuración del Servidor Cloud / API
HOST=0.0.0.0
PORT=8000
SECRET_KEY=focuslock_super_secret_production_key_change_me

# Base de Datos 1: PostgreSQL (Relacional - Sesiones, Histórico, Auditoría)
# Ejemplo local: postgresql://postgres:postgres@localhost:5432/focuslock_db
# Ejemplo Docker Compose: postgresql://focuslock_user:focuslock_pass@postgres:5432/focuslock_db
# Ejemplo Cloud (Render/Railway/Supabase): postgresql://user:password@hostname:5432/database
DATABASE_URL=postgresql://focuslock_user:focuslock_pass@localhost:5432/focuslock_db

# Base de Datos 2: Redis (NoSQL / Memoria / Caché de Telemetría & Adaptador PubSub de Sockets)
# Ejemplo local: redis://localhost:6379/0
# Ejemplo Docker Compose: redis://redis:6379/0
# Ejemplo Cloud (Render/Upstash): rediss://default:password@host:port
REDIS_URL=redis://localhost:6379/0

# Configuración para el Módulo Local (PC / Edge Device)
# Apuntar a localhost en desarrollo y al dominio público en producción
# CLOUD_API_URL=http://localhost:8000
# CLOUD_WS_URL=ws://localhost:8000/ws/telemetry
CLOUD_API_URL=https://digiproy.qd.je
CLOUD_WS_URL=wss://digiproy.qd.je/ws/telemetry

# Umbrales de Detección de Concentración y Ruido (Módulo Local)
CAMERA_DEVICE_INDEX=0
ATTENTION_THRESHOLD=0.65
NOISE_DECIBEL_LIMIT=65.0
TELEMETRY_INTERVAL_SECONDS=1.0
